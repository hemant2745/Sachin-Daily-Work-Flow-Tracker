# ==============================================================================
# Dedicated Supabase Configuration for Sachin Behera Daily Workflow
# NOTE: Do NOT reuse credentials from legacy projects.
# Obtain these from your NEW dedicated Supabase Project Dashboard -> Settings -> API.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-Side Administrator Authorization Allowlist
# Enforces single-administrator access. Only the designated email can access the application.
ADMIN_EMAIL=sachin.behera@collegevidya.com

# Application Metadata
NEXT_PUBLIC_APP_NAME="Sachin Behera Daily Workflow"
NEXT_PUBLIC_APP_URL=http://localhost:3000
